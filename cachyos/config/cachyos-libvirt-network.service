[Unit]
Description=Prepare the default libvirt NAT network without replacing existing definitions
Requires=virtnetworkd.socket virtqemud.socket
After=virtnetworkd.socket virtqemud.socket network.target firewalld.service ufw.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python /usr/local/libexec/cachyos-libvirt-network.py
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
