// System libvirt is root-equivalent. Only the reviewed local desktop account
// gets passwordless access, after a fresh login loads its libvirt membership.
polkit.addRule(function(action, subject) {
    if (action.id == "org.libvirt.unix.manage") {
        if (subject.user == @USER@ && subject.local && subject.active &&
            subject.isInGroup("libvirt")) {
            return polkit.Result.YES;
        }
        // Stop the vendor's later blanket libvirt-group rule for other accounts.
        return polkit.Result.AUTH_ADMIN;
    }
});
