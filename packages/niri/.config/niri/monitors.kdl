// Other monitors are auto-configured.
output "HDMI-A-1" {
    mode "1920x1080@179.999"
    scale 1.0
    position x=0 y=0
    focus-at-startup
    variable-refresh-rate
}

// Enable VRR for laptop display.
output "eDP-1" {
    scale 1.0
    variable-refresh-rate
}

output "Virtual-1" {
    // Intentamos forzar la resolución aunque no aparezca en la lista
    mode "1920x1200@59.950"
    scale 1.0
}
