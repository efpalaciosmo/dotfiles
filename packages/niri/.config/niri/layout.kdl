// ~/.config/niri/layout.kdl

layout {
    center-focused-column "on-overflow"
    always-center-single-column

    // Two useful columns on the laptop; Mod+F still maximizes when needed.
    default-column-width { proportion 0.5; }
    gaps 10

    // Mod+R / Mod+Shift+R: 2/5, 1/2, 3/5, 2/3, completo.
    preset-column-widths {
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.2
        proportion 0.4
        proportion 0.6
        proportion 0.8
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#b8a0ed"
        inactive-color "#403957"
        urgent-color "#f38ba8"
    }

    shadow {
        on
        softness 20
        spread 3
        offset x=0 y=3
        draw-behind-window true
        color "#08091680"
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 4
        width 2
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 6
        active-color "#b8a0ed"
        inactive-color "#6f628e"
        urgent-color "#f38ba8"
    }

    insert-hint {
        on
        color "#b8a0ed80"
    }
}
