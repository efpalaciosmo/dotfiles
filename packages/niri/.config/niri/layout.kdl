// ~/.config/niri/layout.kdl

layout {
    // Do not hide a neighbor by centering when rounding or app minimums overflow.
    center-focused-column "never"
    always-center-single-column

    // Two useful columns on desktop monitors; Mod+F still maximizes when needed.
    default-column-width { proportion 0.5; }
    // At 2560 logical pixels / 150%, 16 keeps quarter/half widths pixel-aligned.
    // With 12, a 25% + 75% pair rounds up to one physical pixel too wide.
    gaps 16

    // Mod+R / Mod+Shift+R: complementary 25/75, 30/70, 40/60, 50/50.
    preset-column-widths {
        proportion 0.25
        proportion 0.3
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.7
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.25
        proportion 0.3
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.75
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        on
        width 2
        // Exact requested orange; quiet Adwaita chrome on inactive windows.
        active-color "#ff7800"
        inactive-color "#45454a"
        urgent-color "#ff938c"
    }

    shadow {
        on
        softness 20
        spread 1
        offset x=0 y=4
        draw-behind-window true
        color "#00000055"
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 4
        width 2
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 6
        active-color "#ff7800"
        inactive-color "#45454a"
        urgent-color "#ff938c"
    }

    insert-hint {
        on
        color "#ff780080"
    }
}
