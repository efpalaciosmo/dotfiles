// System packages/services are installed by make setup;
// Niri starts these processes only inside its own session.
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-sh-at-startup "for agent in /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do if [ -x \"$agent\" ]; then exec \"$agent\"; fi; done"
spawn-sh-at-startup "${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/session-idle"
spawn-sh-at-startup "swaybg -i \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/backgrounds/adwaita-dark.png\" -m fill"

// GDM starts niri-session, which exports the environment to systemd and D-Bus.
// Supervised watchers restart on failure and stop with the graphical session.
spawn-sh-at-startup "systemctl --user daemon-reload && systemctl --user start dotfiles-clipboard-text.service dotfiles-clipboard-image.service"
