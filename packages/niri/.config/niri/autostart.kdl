// Minimal laptop session startup. Package installation is outside this repo;
// niri only starts long-running session processes.
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-sh-at-startup "${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/session-idle"
spawn-sh-at-startup "swaybg -i \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/backgrounds/bluesky.png\" -m fill"

// GDM starts niri-session, which exports the environment to systemd and D-Bus.
// One text watcher and one PNG watcher feed the local SQLite history.
spawn-sh-at-startup "wl-paste --no-newline --type text --watch \"${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/scripts/clipboard-history\" store text"
spawn-sh-at-startup "wl-paste --type image/png --watch \"${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/scripts/clipboard-history\" store image/png"
