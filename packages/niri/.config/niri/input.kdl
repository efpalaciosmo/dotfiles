// ~/.config/niri/input.kdl
// Copy this file to: ~/.config/niri/input.kdl

input {
    keyboard {
        xkb {
        }
        repeat-delay 700
        repeat-rate 22
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    mod-key "Super"
    mod-key-nested "Alt"

    workspace-auto-back-and-forth
}
