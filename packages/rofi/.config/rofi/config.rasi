// ~/.config/rofi/config.rasi
// Configuracion principal de rofi.

configuration {
    modes:                "drun,recursivebrowser,window,run,filebrowser";
    show-icons:           true;
    icon-theme:           "Adwaita";
    display-drun:         "Aplicaciones";
    display-run:          "Comandos";
    display-window:       "Ventanas";
    display-filebrowser:  "Archivos";
    display-recursivebrowser: "Buscar archivos";
    kb-mode-next:         "question,Control+Tab";
    drun-display-format:  "{name}";
    drun-reload-desktop-cache: true;
    window-format:        "{w}  {c}  {t}";
    sidebar-mode:         false;
    terminal:             "ghostty";
    sort:                 true;
    sorting-method:       "fzf";
    matching:             "fuzzy";
    case-sensitive:       false;
    cycle:                true;
    hover-select:         false;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
}

@theme "~/.config/rofi/themes/night-sky.rasi"
