/* Deep blue-slate surfaces inspired by the night sky; GNOME blue accent. */
* {
    font: "Inter 11";
    surface: #272a40;
    view: #202337;
    raised: #343751;
    outline: #ffa348;
    accent: #1c71d8;
    accent-text: #81d0ff;
    foreground: #ffffff;
    muted: #c0bfbc;
    danger: #ff888c;
    background-color: transparent;
    text-color: var(foreground);
}

window {
    width: 620px;
    location: center;
    anchor: center;
    background-color: var(surface);
    border: 1px;
    border-color: var(outline);
    border-radius: 15px;
    padding: 18px;
}

mainbox { spacing: 12px; }

inputbar {
    children: [ prompt, entry ];
    background-color: var(view);
    border: 1px;
    border-color: var(outline);
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 12px;
}

prompt { text-color: var(accent-text); }
entry {
    placeholder: "Buscar…";
    placeholder-color: var(muted);
    text-color: var(foreground);
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 9px;
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: var(accent);
    text-color: var(foreground);
}
element normal.active { text-color: var(accent-text); }
element normal.urgent { text-color: var(danger); }
element-icon { size: 20px; }
element-text { text-color: inherit; highlight: bold underline; }

mode-switcher { spacing: 6px; }
button {
    padding: 6px 12px;
    border-radius: 8px;
    text-color: var(muted);
    background-color: var(raised);
}
button selected {
    text-color: var(foreground);
    background-color: var(accent);
}
