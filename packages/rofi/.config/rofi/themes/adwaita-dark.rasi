/* A quiet plum panel with clear lilac focus. */
* {
    font: "Inter 11";
    surface: #241f31;
    view: #30283f;
    raised: #40334f;
    line: #665475;
    accent: #d9b8ff;
    accent-text: #241f31;
    foreground: #f5effa;
    muted: #b6a9c7;
    danger: #ff8c9b;
    background-color: transparent;
    text-color: var(foreground);
}

window {
    width: 620px;
    location: center;
    anchor: center;
    background-color: var(surface);
    border: 1px;
    border-color: var(line);
    border-radius: 16px;
    padding: 16px;
}

mainbox { spacing: 12px; }

inputbar {
    children: [ prompt, entry ];
    background-color: var(view);
    border: 1px;
    border-color: var(line);
    border-radius: 10px;
    padding: 12px 14px;
    spacing: 12px;
}

prompt { text-color: var(accent); }
entry {
    placeholder: "Buscar…";
    placeholder-color: var(muted);
    text-color: var(foreground);
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 9px;
    background-color: transparent;
}
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: var(accent);
    text-color: var(accent-text);
}
element normal.active { text-color: var(accent); }
element normal.urgent { text-color: var(danger); }
element-icon { size: 20px; }
element-text { text-color: inherit; highlight: bold underline; }

message {
    background-color: var(view);
    border-radius: 8px;
    padding: 9px 12px;
}
textbox { text-color: var(muted); }

mode-switcher { spacing: 6px; }
button {
    padding: 6px 12px;
    border-radius: 8px;
    text-color: var(muted);
    background-color: var(raised);
}
button selected {
    text-color: var(accent-text);
    background-color: var(accent);
}
