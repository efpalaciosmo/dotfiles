#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
# shellcheck source=common
. "$script_dir/common"

missing_commands niri || exit 1

choice=$(menu "Screenshot" \
    "󰩭  Select area" \
    "󰹑  Current screen" \
    "󰖯  Current window" || true)

case "$choice" in
    *"Select area") niri msg action screenshot ;;
    *"Current screen") niri msg action screenshot-screen ;;
    *"Current window") niri msg action screenshot-window ;;
esac
