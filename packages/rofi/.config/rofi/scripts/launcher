#!/usr/bin/env bash
set -euo pipefail

mode=${1:-drun}

case "$mode" in
    drun|recursivebrowser|run|window|ssh|filebrowser) ;;
    *) mode=drun ;;
esac

if command -v rofi >/dev/null 2>&1; then
    exec rofi -show "$mode" \
        -show-icons \
        -drun-use-desktop-cache \
        -drun-reload-desktop-cache \
        -recursivebrowser-directory "$HOME" \
        -kb-mode-next "question,Control+Tab"
fi

printf 'Rofi is not installed.\n' >&2
exit 1
