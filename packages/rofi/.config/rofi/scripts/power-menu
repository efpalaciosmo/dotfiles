#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
# shellcheck source=common
. "$script_dir/common"

confirm() {
    local prompt=$1 confirm_label=$2 choice
    choice=$(menu "$prompt" "Cancel" "$confirm_label" || true)
    [[ "$choice" == "$confirm_label" ]]
}

run_systemctl() {
    local action=$1

    if systemctl "$action"; then
        return 0
    fi

    notify_user "Power menu" "Could not run: systemctl $action"
    return 1
}

turn_displays_off() {
    if command -v niri >/dev/null 2>&1 && niri msg action power-off-monitors; then
        return 0
    fi

    notify_user "Power menu" "Could not put displays to sleep"
    return 1
}

lock_session() {
    if command -v swaylock >/dev/null 2>&1; then
        swaylock -f -c 222226 || notify_user "Power menu" "Could not lock the session"
    elif command -v loginctl >/dev/null 2>&1; then
        loginctl lock-session || notify_user "Power menu" "Could not lock the session"
    else
        notify_user "Power menu" "No screen locker found"
    fi
}

logout_session() {
    if command -v niri >/dev/null 2>&1; then
        niri msg action quit
    elif [[ -n "${XDG_SESSION_ID:-}" ]] && command -v loginctl >/dev/null 2>&1; then
        loginctl terminate-session "$XDG_SESSION_ID"
    fi
}

choice=$(menu "Power" \
    "  Bloquear" \
    "⏾  Suspender" \
    "󰍹  Apagar pantalla" \
    "  Cerrar sesión" \
    "  Reiniciar" \
    "  Apagar" || true)

case "$choice" in
    "  Apagar")
        confirm "¿Apagar el equipo?" "Apagar" && run_systemctl poweroff
        ;;
    "  Reiniciar")
        confirm "¿Reiniciar el equipo?" "Reiniciar" && run_systemctl reboot
        ;;
    "⏾  Suspender")
        confirm "¿Suspender el equipo?" "Suspender" && run_systemctl suspend
        ;;
    "  Bloquear")
        lock_session
        ;;
    "  Cerrar sesión")
        confirm "¿Cerrar sesión?" "Cerrar sesión" && logout_session
        ;;
    "󰍹  Apagar pantalla")
        turn_displays_off
        ;;
esac
