font=Adwaita Sans 11
width=380
height=200
margin=16
padding=16,18
border-size=1
border-radius=12
icons=1
max-icon-size=64
markup=1
actions=1
default-timeout=8000
ignore-timeout=0
max-visible=4
sort=-time
anchor=top-right

background-color=#36363a
text-color=#ffffff
border-color=#505055
progress-color=over #ff780033

[urgency=low]
text-color=#c0bfbc
border-color=#45454a
progress-color=over #ffffff14
default-timeout=5000

[urgency=high]
text-color=#ffffff
border-color=#ff938c
progress-color=over #ff938c33
default-timeout=0

[app-name=volume]
border-color=#ff7800
progress-color=over #ff780033

[app-name=Spotify]
border-color=#505055
progress-color=over #ff780033
