#!/usr/bin/env bash
# yazi-smb: mount an SMB share with GVfs (`gio mount`) and make the running Yazi jump into it.
#
#   yazi-smb mount [server/share]   mount and enter (asks for the address when omitted)
#   yazi-smb unmount                unmount a share (asks which one if several are mounted)
#
# Yazi starts it through `shell --block` (keymap.toml: g s / g u), so GVfs can ask for the user
# name and password on the terminal. Outside Yazi it just prints the mount path.
# Accepted addresses: server/share, //server/share, \\server\share, smb://server/share.
set -Eeuo pipefail
shopt -s extglob

fail() {
    printf 'yazi-smb: %s\n' "$*" >&2
    # Under `shell --block` the screen is restored as soon as we exit; let the error be read.
    if [[ -t 0 ]]; then read -r -p 'Press Enter to return... ' _ || true; fi
    exit 1
}

command -v gio >/dev/null 2>&1 || fail 'gio (GLib/GVfs) is not installed'

# Move the running Yazi to DIR. Queued until Yazi takes the terminal back.
jump() {
    if [[ -n ${YAZI_ID:-} ]] && command -v ya >/dev/null 2>&1; then
        ya emit-to "$YAZI_ID" cd "$1"
        return 0
    fi
    return 1
}

mount_share() {
    local address=${1:-} uri path
    if [[ -z $address ]]; then
        read -r -p 'SMB share (server/share, //server/share or smb://server/share): ' address ||
            exit 1
    fi

    # Trim before looking for the scheme, so a pasted "  smb://host/share " is recognized.
    address=${address##+([[:space:]])}
    address=${address%%+([[:space:]])}
    address=${address//\\//}
    address=${address#smb://}
    address=${address##+(/)}
    address=${address%%+(/)}
    # Only the server part is restricted (no options, schemes or substitutions can start the
    # string); the share path is handed to gio as one literal argument and never evaluated.
    [[ $address =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?(/[^[:cntrl:]]*)?$ ]] ||
        fail "not a valid server or server/share address: ${address:-<empty>}"

    uri=smb://$address
    # `gio info` fails quietly for a share that is not mounted yet and never prompts.
    if ! gio info "$uri" >/dev/null 2>&1; then
        gio mount "$uri" || fail "could not mount $uri"
    fi

    path=$(gio info "$uri" 2>/dev/null | sed -n 's/^local path: //p')
    [[ -n $path && -d $path ]] || fail "$uri is mounted but has no local path (is gvfs-fuse running?)"
    jump "$path" || printf '%s\n' "$path"
}

unmount_share() {
    local -a mounts
    local uri
    mapfile -t mounts < <(gio mount -l 2>/dev/null | grep -o -- '-> smb://.*' | sed 's/^-> //; s#/$##' | sort -u)

    case ${#mounts[@]} in
        0) fail 'no SMB shares are mounted' ;;
        1) uri=${mounts[0]} ;;
        *)
            PS3='Unmount which share? '
            select uri in "${mounts[@]}"; do [[ -n $uri ]] && break; done
            [[ -n ${uri:-} ]] || exit 1
            ;;
    esac

    gio mount -u "$uri" || fail "could not unmount $uri (is something still using it?)"
    # Yazi would otherwise keep showing a directory that no longer exists.
    jump "$HOME" || printf 'unmounted %s\n' "$uri"
}

case ${1:-mount} in
    mount) mount_share "${2:-}" ;;
    unmount | umount) unmount_share ;;
    *) fail "usage: yazi-smb mount [server/share] | unmount" ;;
esac
