[Desktop Entry]
Name=Yazi
GenericName=File Manager
Comment=Terminal file manager
Exec=ghostty --class=org.dotfiles.Yazi --title=Files --confirm-close-surface=false -e yazi %f
TryExec=yazi
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;directory;browse;
StartupWMClass=org.dotfiles.Yazi
