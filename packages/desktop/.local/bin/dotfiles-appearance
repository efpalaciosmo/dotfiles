#!/usr/bin/env bash
# Use supported system preferences so GTK/libadwaita and portals agree.
set -euo pipefail

# The first full install may run from a TTY, before any graphical login. Give
# dconf a session bus so preferences persist instead of silently failing to save.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    command -v dbus-run-session >/dev/null 2>&1 || {
        printf 'appearance: dbus-run-session is required outside a desktop session\n' >&2
        exit 1
    }
    exec dbus-run-session -- "$0" "$@"
fi

schema=org.gnome.desktop.interface
command -v gsettings >/dev/null 2>&1 || {
    printf 'appearance: gsettings is required\n' >&2
    exit 1
}
keys=$(gsettings list-keys "$schema")

set_preference() {
    local key=$1 value=$2
    if ! grep -Fxq "$key" <<< "$keys"; then
        printf 'appearance: %s is unavailable in this GNOME version; skipped\n' "$key" >&2
        return
    fi
    if [[ $(gsettings writable "$schema" "$key") != true ]]; then
        printf 'appearance: %s is locked by system policy\n' "$key" >&2
        return 1
    fi
    if [[ $(gsettings get "$schema" "$key") != "$value" ]]; then
        gsettings set "$schema" "$key" "$value"
        if [[ $(gsettings get "$schema" "$key") != "$value" ]]; then
            printf 'appearance: failed to persist %s (check the user D-Bus/dconf session)\n' "$key" >&2
            return 1
        fi
    fi
}

set_preference color-scheme "'prefer-dark'"
set_preference gtk-theme "'Adwaita-dark'"
set_preference icon-theme "'Adwaita'"
set_preference cursor-theme "'Adwaita'"
set_preference cursor-size 24
set_preference font-name "'JetBrainsMono Nerd Font 12'"
set_preference document-font-name "'JetBrainsMono Nerd Font 12'"
set_preference monospace-font-name "'JetBrainsMono Nerd Font 12'"
# Native Adwaita orange is #ed5b00; compositor focus is exactly #ff7800.
set_preference accent-color "'orange'"

# Server-decorated titles should agree with GTK client-side titlebars too.
schema=org.gnome.desktop.wm.preferences
if keys=$(gsettings list-keys "$schema" 2>/dev/null); then
    set_preference titlebar-font "'JetBrainsMono Nerd Font Bold 12'"
    set_preference titlebar-uses-system-font true
else
    printf 'appearance: window-title font preferences unavailable; skipped\n' >&2
fi
printf 'appearance: Adwaita dark with orange accent and JetBrains fonts applied\n'
