# Neutral Adwaita chrome. Documents retain their original colors.
set font "Adwaita Sans 11"
set default-bg "#1d1d20"
set default-fg "#ffffff"
set statusbar-bg "#222226"
set statusbar-fg "#c0bfbc"
set inputbar-bg "#36363a"
set inputbar-fg "#ffffff"
set completion-bg "#36363a"
set completion-fg "#ffffff"
set completion-highlight-bg "#ff7800"
set completion-highlight-fg "#1d1d20"
set completion-group-bg "#222226"
set completion-group-fg "#ff9c5b"
set notification-bg "#36363a"
set notification-fg "#ffffff"
set notification-warning-bg "#ffc252"
set notification-warning-fg "#1d1d20"
set notification-error-bg "#ff938c"
set notification-error-fg "#1d1d20"
set highlight-color "#ff780080"
set highlight-active-color "#ff7800"
