# Both this configuration and its theme are managed by GNU Stow.
theme = Adwaita Dark Orange
# Reset the fallback list when old/new Ghostty entry points both load this file.
font-family = ""
font-family = JetBrainsMono Nerd Font
font-family = JetBrains Mono
font-size = 15
background-opacity = 1
cursor-style = bar
window-padding-x = 12
window-padding-y = 12
window-theme = dark
