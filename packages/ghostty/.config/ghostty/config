# Ghostty configuration for Fedora
# Adwaita Dark theme with JetBrainsMono Nerd Font Medium

# Preserve Ghostty capabilities through sudo and remote SSH sessions.
shell-integration-features = sudo,ssh-env,ssh-terminfo

# Font
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 15
font-feature = liga

# Window
window-height = 40
window-width = 130
window-padding-x = 12
window-padding-y = 12
window-vsync = true

# Adwaita Dark colors
background = #1a1a1d
foreground = #e0e0e0

# ANSI palette
palette = 0=#000000
palette = 1=#e01b24
palette = 2=#33d17a
palette = 3=#f6d32d
palette = 4=#3584e4
palette = 5=#9141ac
palette = 6=#33d17a
palette = 7=#deddda
palette = 8=#77767b
palette = 9=#f66151
palette = 10=#8ff0a4
palette = 11=#f9f06b
palette = 12=#99c1f1
palette = 13=#dc8add
palette = 14=#8de698
palette = 15=#ffffff

# Cursor
cursor-style = block
cursor-opacity = 1.0
cursor-color = #ffbe6f

# Scrollback
scrollback-limit = 100000
