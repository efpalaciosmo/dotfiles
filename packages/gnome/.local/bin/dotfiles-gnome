#!/usr/bin/python3
"""Apply personal GNOME preferences and native per-monitor 150% 4K scaling."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path


TERMINAL_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/dotfiles-ghostty/"
CUSTOM_SCHEMA = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
DISPLAY_INTERFACE = "org.gnome.Mutter.DisplayConfig"
WM_KEYBINDINGS = "org.gnome.desktop.wm.keybindings"
MUTTER_KEYBINDINGS = "org.gnome.mutter.keybindings"
MEDIA_KEYBINDINGS = "org.gnome.settings-daemon.plugins.media-keys"


def add_shortcuts(store, schema, key, shortcuts, *, remove=()):
    """Add aliases, retiring only explicitly superseded/conflicting bindings."""
    current = store.get(schema, key)
    retained = [shortcut for shortcut in current if shortcut not in remove]
    combined = retained + [shortcut for shortcut in shortcuts if shortcut not in retained]
    if combined != current:
        store.set(schema, key, combined)


def configure_window_shortcuts(store):
    """Native GNOME equivalents; no Shell extensions or synthetic key events."""
    # Reserve Super+H/L for tiling instead of minimize/lock. Keep other aliases
    # and replace the lock binding atomically so a working lock shortcut remains.
    add_shortcuts(store, WM_KEYBINDINGS, "minimize", [], remove=["<Super>h"])
    add_shortcuts(store, MEDIA_KEYBINDINGS, "screensaver", ["<Super><Alt>l"], remove=["<Super>l"])
    for key, shortcut in {
        "close": "<Super>q",
        "toggle-maximized": "<Super>f",
        "toggle-fullscreen": "<Super><Shift>f",
        "maximize": "<Super>k",
        "unmaximize": "<Super>j",
        "move-to-center": "<Super>c",
        # Niri's down/up workspace navigation maps to GNOME's right/left.
        "switch-to-workspace-right": "<Super>u",
        "switch-to-workspace-left": "<Super>i",
        "move-to-workspace-right": "<Super><Control>u",
        "move-to-workspace-left": "<Super><Control>i",
        "move-to-monitor-left": "<Super><Control><Shift>h",
        "move-to-monitor-down": "<Super><Control><Shift>j",
        "move-to-monitor-up": "<Super><Control><Shift>k",
        "move-to-monitor-right": "<Super><Control><Shift>l",
    }.items():
        add_shortcuts(store, WM_KEYBINDINGS, key, [shortcut])
    # GNOME has native left/right half-tiling, but no top/bottom half-tiling;
    # J/K use the native down/up equivalents (restore/maximize).
    add_shortcuts(store, MUTTER_KEYBINDINGS, "toggle-tiled-left", ["<Super>h"], remove=["<Super><Control>h"])
    add_shortcuts(store, MUTTER_KEYBINDINGS, "toggle-tiled-right", ["<Super>l"], remove=["<Super><Control>l"])


def configure_preferences(store):
    """Keep unrelated shortcuts; add Niri-like controls and four workspaces."""
    store.set("org.gnome.mutter", "dynamic-workspaces", False)
    store.set("org.gnome.desktop.wm.preferences", "num-workspaces", 4)
    for number in range(1, 5):
        store.set("org.gnome.shell.keybindings", f"switch-to-application-{number}", [])
        add_shortcuts(store, WM_KEYBINDINGS, f"switch-to-workspace-{number}",
                      [f"<Super>{number}"])
        add_shortcuts(store, WM_KEYBINDINGS, f"move-to-workspace-{number}",
                      [f"<Super><Shift>{number}"], remove=[f"<Super><Control>{number}"])
    configure_window_shortcuts(store)
    schema = "org.gnome.settings-daemon.plugins.media-keys"
    paths = store.get(schema, "custom-keybindings")
    if TERMINAL_PATH not in paths:
        store.set(schema, "custom-keybindings", paths + [TERMINAL_PATH])
    store.set(CUSTOM_SCHEMA, "name", "Ghostty", TERMINAL_PATH)
    store.set(CUSTOM_SCHEMA, "command", "ghostty", TERMINAL_PATH)
    store.set(CUSTOM_SCHEMA, "binding", "<Super>Return", TERMINAL_PATH)


class Preferences:
    def __init__(self, Gio, GLib):
        self.Gio, self.GLib = Gio, GLib
        self.source = Gio.SettingsSchemaSource.get_default()
        self.settings = {}
        state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        self.backup = state / "dotfiles/gnome-preferences.before.json"
        self.original = json.loads(self.backup.read_text()) if self.backup.exists() else {}

    def setting(self, schema, path=None):
        identity = (schema, path)
        if identity not in self.settings:
            definition = self.source.lookup(schema, True) if self.source else None
            if definition is None:
                raise RuntimeError(f"GNOME settings schema unavailable: {schema}")
            self.settings[identity] = self.Gio.Settings.new_full(definition, None, path)
        return self.settings[identity]

    def get(self, schema, key, path=None):
        return self.setting(schema, path).get_value(key).unpack()

    def set(self, schema, key, value, path=None):
        settings = self.setting(schema, path)
        previous = settings.get_value(key)
        if previous.unpack() == value:
            return
        if not settings.is_writable(key):
            raise RuntimeError(f"GNOME preference locked by policy: {schema} {key}")
        identity = f"{schema}:{path or ''}:{key}"
        if identity not in self.original:
            self.original[identity] = previous.unpack()
            self.backup.parent.mkdir(parents=True, exist_ok=True)
            self.backup.write_text(json.dumps(self.original, indent=2) + "\n")
        if not settings.set_value(key, self.GLib.Variant(previous.get_type_string(), value)):
            raise RuntimeError(f"Could not save GNOME preference: {schema} {key}")
        self.Gio.Settings.sync()
        if self.get(schema, key, path) != value:
            raise RuntimeError(f"GNOME preference did not persist: {schema} {key}")


def display_plan(state):
    """Change only active 4K groups; preserve modes, transforms and positions.

    Refuse unsupported scales or overlapping layouts rather than silently
    changing resolution, disabling a display, or rearranging a mixed-DPI setup.
    """
    serial, monitors, logical, properties = state
    current = {}
    for spec, modes, props in monitors:
        mode = next((mode for mode in modes if mode[6].get("is-current")), None)
        if mode is not None:
            current[tuple(spec)] = (mode, props)
    planned, rectangles, changed = [], [], False
    for x, y, scale, transform, primary, specs, _ in logical:
        active = [current[tuple(spec)] for spec in specs]
        is_4k = [max(mode[1:3]) >= 3840 and min(mode[1:3]) >= 2160
                 for mode, _ in active]
        if any(is_4k):
            if not all(is_4k):
                raise RuntimeError("Mixed-resolution mirror group: set scaling in GNOME Displays")
            if any(not any(abs(supported - 1.5) < 0.001 for supported in mode[5])
                   for mode, _ in active):
                raise RuntimeError("150% is unavailable: enable fractional scaling in GNOME Displays first")
            changed |= abs(scale - 1.5) > 0.001
            scale = 1.5
        outputs = []
        for spec, (mode, props) in zip(specs, active):
            options = {}
            if "is-underscanning" in props:
                options["underscanning"] = props["is-underscanning"]
            if "color-mode" in props:
                options["color-mode"] = props["color-mode"]
            outputs.append((spec[0], mode[0], options))
        planned.append((x, y, scale, transform, primary, outputs))
        width, height = active[0][0][1:3]
        if transform % 2:
            width, height = height, width
        rectangles.append((x, y, x + round(width / scale), y + round(height / scale)))
    if not changed:
        return None
    if properties.get("layout-mode", 1) != 1:
        raise RuntimeError("150% profile requires GNOME Wayland logical display layout")
    if properties.get("global-scale-required") and any(abs(item[2] - 1.5) > 0.001 for item in planned):
        raise RuntimeError("This session requires one global scale; configure mixed displays manually")
    for index, (left, top, right, bottom) in enumerate(rectangles):
        for other_left, other_top, other_right, other_bottom in rectangles[index + 1:]:
            if left < other_right and other_left < right and top < other_bottom and other_top < bottom:
                raise RuntimeError("150% would overlap displays: adjust their positions in GNOME Displays")
    return serial, planned, properties


def configure_displays(Gio, GLib):
    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
        DISPLAY_INTERFACE, "/org/gnome/Mutter/DisplayConfig", DISPLAY_INTERFACE, None)
    state = proxy.call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, 10000, None).unpack()
    plan = display_plan(state)
    if plan is None:
        print("gnome: active 4K displays already at 150% (or no active 4K display)")
        return
    serial, logical, properties = plan
    typed = []
    for x, y, scale, transform, primary, outputs in logical:
        typed_outputs = [(connector, mode, {
            key: GLib.Variant("b" if key == "underscanning" else "u", value)
            for key, value in options.items()
        }) for connector, mode, options in outputs]
        typed.append((x, y, scale, transform, primary, typed_outputs))
    options = {}
    if properties.get("supports-changing-layout-mode"):
        options["layout-mode"] = GLib.Variant("u", 1)
    # Verify before requesting a persistent configuration. GNOME may display
    # its normal confirmation dialog; do not bypass that recovery mechanism.
    for method in (0, 2):
        parameters = GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, method, typed, options))
        proxy.call_sync("ApplyMonitorsConfig", parameters, Gio.DBusCallFlags.NONE, 10000, None)
    print("gnome: requested persistent 150% scaling; confirm Keep Changes if GNOME asks")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--preferences-only", action="store_true", help="skip live monitor configuration")
    args = parser.parse_args()
    if "gnome" not in os.environ.get("XDG_CURRENT_DESKTOP", "").lower().split(":"):
        print("gnome: skipped outside a GNOME session")
        return 0
    try:
        from gi.repository import Gio, GLib
    except ImportError:
        print("gnome: system Python PyGObject (Gio/GLib) is required; provide it through your distribution", file=sys.stderr)
        return 1
    try:
        subprocess.run([str(Path.home() / ".local/bin/dotfiles-appearance")], check=True)
        configure_preferences(Preferences(Gio, GLib))
        print("gnome: four fixed workspaces, Niri-like window shortcuts and Super+Return applied")
        if not args.preferences_only:
            configure_displays(Gio, GLib)
    except (OSError, RuntimeError, KeyError, GLib.Error, subprocess.SubprocessError) as error:
        print(f"gnome: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
