{
    "layer": "top",
    "position": "bottom",
    "height": 41,
    "spacing": 4,
    "margin-bottom": 8,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["custom/media"],
    "modules-right": ["tray", "privacy", "idle_inhibitor", "custom/network-speed", "pulseaudio", "custom/cpu", "memory", "clock", "custom/power"],

    "niri/workspaces": {
        "format": "{index}",
        "tooltip": false
    },
    "niri/window": {
        "format": "{}",
        "max-length": 26,
        "separate-outputs": true
    },
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media-status",
        "return-type": "json",
        "format": "{icon}  {text}",
        "format-icons": {
            "playing": "<span color='#8ff0a4'></span>",
            "paused": "<span color='#c0bfbc'></span>",
            "stopped": "<span color='#9a9996'></span>"
        },
        "hide-empty-text": true,
        "interval": 3,
        "max-length": 30,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "tray": { "icon-size": 19, "spacing": 8 },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 17,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-out", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Idle inhibited · click to allow",
        "tooltip-format-deactivated": "Idle allowed · click to inhibit"
    },
    "custom/network-speed": {
        "exec": "~/.config/waybar/scripts/network-speed",
        "return-type": "json",
        "format": "{icon}  {text}",
        "format-icons": {
            "wifi": "<span color='#99c1f1'>󰤨</span>",
            "ethernet": "<span color='#99c1f1'>󰈀</span>",
            "disconnected": "<span color='#ff938c'>󰤮</span>"
        },
        "escape": true,
        "interval": 3,
        "on-click": "~/.config/fuzzel/scripts/wifi",
        "on-click-right": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "<span color='#f9f06b'>{icon}</span>  {volume}%",
        "format-bluetooth": "<span color='#99c1f1'>{icon}</span>  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": { "headphone": "", "default": ["", "", ""] },
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.config/waybar/scripts/terminal-tool audio"
    },
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-status",
        "return-type": "json",
        "format": "{icon}  {text}",
        "format-icons": {
            "normal": "<span color='#ffbe6f'></span>",
            "warning": "<span color='#ffc252'></span>",
            "critical": "<span color='#1d1d20'></span>"
        },
        "escape": true,
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/terminal-tool monitor"
    },
    "memory": {
        "format": "<span color='#dc8add'>󰍛</span>  {}%",
        "format-critical": "󰍛  {}%",
        "interval": 10,
        "states": { "critical": 85 },
        "on-click": "~/.config/waybar/scripts/terminal-tool monitor",
        "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB"
    },
    "clock": {
        "locale": "en_US.UTF-8",
        "format": "<span color='#ff9c5b'></span>  {:%a %d · %H:%M}",
        "format-alt": "<span color='#ff9c5b'></span>  {:%d/%m/%Y · %H:%M}",
        "on-click": "~/.config/waybar/scripts/open-calendar",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 1,
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#ff9c5b'><b>{}</b></span>",
                "weekdays": "<span color='#c0bfbc'><b>{}</b></span>",
                "weeks": "<span color='#9a9996'>{}</span>",
                "days": "<span color='#ffffff'>{}</span>",
                "today": "<span color='#1d1d20' bgcolor='#ff7800'><b>{}</b></span>"
            }
        }
    },
    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Power · lock, suspend or shut down",
        "on-click": "~/.config/fuzzel/scripts/power-menu"
    }
}
