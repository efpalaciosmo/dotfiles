{
    "layer": "top",
    "position": "bottom",
    "height": 46,
    "spacing": 6,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "custom/media"
    ],

    "modules-right": [
        "tray",
        "privacy",
        "idle_inhibitor",
        "custom/network-speed",
        "pulseaudio",
        "custom/cpu",
        "memory",
        "disk",
        "custom/battery",
        "clock",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "niri/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },

    "custom/media": {
        "exec": "~/.config/waybar/scripts/media-status",
        "exec-if": "~/.config/waybar/scripts/media-status --available",
        "return-type": "json",
        "interval": 2,
        "max-length": 32,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "tray": {
        "spacing": 10,
        "show-passive-items": true,
        "reverse-direction": true
    },

    "privacy": {
        "icon-spacing": 4,
        "icon-size": 15,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 20
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 20
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 20
            }
        ]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle inhibitor is on",
        "tooltip-format-deactivated": "Idle inhibitor is off"
    },

    "custom/network-speed": {
        "exec": "~/.config/waybar/scripts/network-speed",
        "return-type": "json",
        "interval": 1,
        "on-click": "nm-connection-editor",
        "on-click-right": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" network'"
    },

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth-status",
        "return-type": "json",
        "interval": 10,
        "on-click": "sh -c 'bluetoothctl power on || notify-send Bluetooth \"Could not power on Bluetooth\"'",
        "on-click-right": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" bluetooth'"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "sh -c 'if command -v pavucontrol >/dev/null 2>&1; then exec pavucontrol; else exec \"$HOME/.config/waybar/scripts/terminal-tool\" audio; fi'"
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-status",
        "return-type": "json",
        "interval": 3,
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" monitor'"
    },

    "memory": {
        "format": "󰍛  {}%",
        "states": {
            "critical": 80
        },
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" monitor'",
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-status",
        "exec-if": "~/.config/waybar/scripts/gpu-status --available",
        "return-type": "json",
        "interval": 5,
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" gpu'"
    },

    "disk": {
        "interval": 30,
        "format": "  {percentage_used}%",
        "path": "/var/home",
        "states": {
            "critical": 80
        },
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/terminal-tool\" disk'",
        "tooltip-format": "{used} / {total}"
    },

    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery-status",
        "exec-if": "~/.config/waybar/scripts/battery-status --available",
        "return-type": "json",
        "interval": 30
    },

    "clock": {
        "format": "  {:%a %d %b     %H:%M}",
        "format-alt": "  {:%H:%M:%S}",
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/open-calendar\"'",
        "locale": "C.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 1,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#3584e4'><b>{}</b></span>",
                "weekdays": "<span color='#62a0ea'><b>{}</b></span>",
                "weeks": "<span color='#77767b'>{}</span>",
                "days": "<span color='#f6f5f4'>{}</span>",
                "today": "<span color='#ffffff' bgcolor='#3584e4'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Power menu\nPower off, reboot, suspend, lock, log out",
        "on-click": "sh -c 'exec \"$HOME/.config/waybar/scripts/power-menu\"'"
    }
}
