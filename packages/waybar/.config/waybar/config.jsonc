{
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 3,
    "margin-bottom": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["custom/media"],
    "modules-right": ["tray", "privacy", "idle_inhibitor", "custom/network-speed", "backlight", "pulseaudio", "custom/cpu", "memory", "custom/battery", "clock", "custom/power"],

    "niri/workspaces": {
        "format": "{index}",
        "tooltip": false
    },
    "niri/window": {
        "format": "{}",
        "max-length": 26,
        "separate-outputs": true
    },
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media-status",
        "return-type": "json",
        "interval": 3,
        "max-length": 30,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "tray": { "spacing": 6 },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 13,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-out", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Reposo bloqueado · clic para permitirlo",
        "tooltip-format-deactivated": "Reposo permitido · clic para bloquearlo"
    },
    "custom/network-speed": {
        "exec": "~/.config/waybar/scripts/network-speed",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/rofi/scripts/wifi",
        "on-click-right": "nm-connection-editor"
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brillo: {percent}%",
        "on-scroll-up": "brightnessctl --class=backlight set +5%",
        "on-scroll-down": "brightnessctl --class=backlight set 5%-"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "󰝟  silencio",
        "format-icons": { "headphone": "", "default": ["", "", ""] },
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.config/waybar/scripts/terminal-tool audio"
    },
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/terminal-tool monitor"
    },
    "memory": {
        "format": "󰍛  {}%",
        "interval": 10,
        "states": { "critical": 85 },
        "on-click": "~/.config/waybar/scripts/terminal-tool monitor",
        "tooltip-format": "Memoria: {used:0.1f} / {total:0.1f} GiB"
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery-status",
        "exec-if": "~/.config/waybar/scripts/battery-status --available",
        "return-type": "json",
        "interval": 30
    },
    "clock": {
        "format": "  {:%a %d · %H:%M}",
        "format-alt": "  {:%d/%m/%Y · %H:%M}",
        "on-click": "~/.config/waybar/scripts/open-calendar",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 1,
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#d9b8ff'><b>{}</b></span>",
                "weekdays": "<span color='#b6a9c7'><b>{}</b></span>",
                "weeks": "<span color='#8c7e9e'>{}</span>",
                "days": "<span color='#f5effa'>{}</span>",
                "today": "<span color='#241f31' bgcolor='#d9b8ff'><b>{}</b></span>"
            }
        }
    },
    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Energía · bloquear, suspender o apagar",
        "on-click": "~/.config/rofi/scripts/power-menu"
    }
}
