#!/usr/bin/env bash
set -euo pipefail

notify_user() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$@" || true
    fi
}

pause='printf "\nPress Enter to close..."; read -r _'

run_terminal() {
    local title=$1
    local command=$2
    local shell_command="${command}; status=\$?; ${pause}; exit \$status"

    if command -v ghostty >/dev/null 2>&1; then
        exec ghostty --title="$title" -e bash -lc "$shell_command"
    fi

    notify_user "Waybar" "Ghostty is not installed"
    exit 1
}

case "${1:-shell}" in
    monitor|cpu|memory)
        run_terminal "System monitor" "btop"
        ;;
    disk)
        cmd='df -h /; printf "\n"; lsblk -o NAME,SIZE,FSTYPE,FSUSE%,FSAVAIL,MOUNTPOINTS 2>/dev/null || true'
        run_terminal "Disk usage" "$cmd"
        ;;
    network)
        cmd='nmcli device status 2>/dev/null || true; printf "\nActive connections:\n"; nmcli connection show --active 2>/dev/null || true; printf "\nAddresses:\n"; ip -brief address 2>/dev/null || true'
        run_terminal "Network status" "$cmd"
        ;;
    audio)
        cmd='wpctl status'
        run_terminal "Audio status" "$cmd"
        ;;
    calendar)
        run_terminal "Calendar" "cal -3"
        ;;
    *)
        run_terminal "Terminal" "${SHELL:-bash}"
        ;;
esac
