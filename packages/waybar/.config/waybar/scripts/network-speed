#!/usr/bin/env bash
set -u

json_escape() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    printf '%s' "$s"
}

route=$(ip -4 route show default 2>/dev/null | head -n 1)
[[ -n "$route" ]] || route=$(ip -6 route show default 2>/dev/null | head -n 1)
if [[ ! "$route" =~ (^|[[:space:]])dev[[:space:]]+([^[:space:]]+) ]]; then
    printf '{"text":"󰤮  sin red","tooltip":"Sin ruta de red · clic para elegir Wi-Fi","class":"disconnected"}\n'
    exit 0
fi

iface=${BASH_REMATCH[2]}
stats="/sys/class/net/$iface/statistics"
if [[ ! -r "$stats/rx_bytes" || ! -r "$stats/tx_bytes" ]]; then
    printf '{"text":"󰤮  sin red","tooltip":"Interfaz sin estadísticas","class":"disconnected"}\n'
    exit 0
fi

connection=$(nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null | head -n 1)
[[ -n "$connection" && "$connection" != -- ]] || connection=$iface
icon="󰈀"
signal=""
if [[ -d "/sys/class/net/$iface/wireless" ]]; then
    icon="󰤨"
    signal=$(nmcli -g IN-USE,SIGNAL device wifi list ifname "$iface" 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }')
fi

rx=$(<"$stats/rx_bytes")
tx=$(<"$stats/tx_bytes")
now=$(date +%s%N)
down="0.0"
up="0.0"
# Runtime state belongs to this login; a fresh session starts with no sample.
if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
    state_file="$XDG_RUNTIME_DIR/waybar-network-speed"
    if [[ -r "$state_file" ]]; then
        read -r previous_iface previous_rx previous_tx previous_time < "$state_file" || true
        if [[ "$previous_iface" == "$iface" && "$previous_rx" =~ ^[0-9]+$ && "$previous_tx" =~ ^[0-9]+$ && "$previous_time" =~ ^[0-9]+$ ]] &&
            (( now > previous_time && rx >= previous_rx && tx >= previous_tx )); then
            down=$(awk -v bytes="$((rx - previous_rx))" -v ns="$((now - previous_time))" 'BEGIN { printf "%.1f", bytes * 8000 / ns }')
            up=$(awk -v bytes="$((tx - previous_tx))" -v ns="$((now - previous_time))" 'BEGIN { printf "%.1f", bytes * 8000 / ns }')
        fi
    fi
    printf '%s %s %s %s\n' "$iface" "$rx" "$tx" "$now" > "$state_file" 2>/dev/null || true
fi

tooltip="${connection} (${iface})"
[[ -n "$signal" ]] && tooltip+=$'\n'"Señal: ${signal}%"
tooltip+=$'\n'"Descarga: ${down} Mb/s · subida: ${up} Mb/s"$'\n'"Clic: Wi-Fi · clic derecho: conexiones"
printf '{"text":"%s","tooltip":"%s","class":"connected"}\n' \
    "$(json_escape "$icon  ↓${down} ↑${up} Mb/s")" "$(json_escape "$tooltip")"
