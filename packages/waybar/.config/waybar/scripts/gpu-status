#!/usr/bin/env bash
set -u

json_escape() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

find_gpu() {
    local dev class vendor
    for dev in /sys/class/drm/card*/device; do
        [[ -r "$dev/class" && -r "$dev/vendor" ]] || continue
        class=$(<"$dev/class")
        vendor=$(<"$dev/vendor")
        [[ "$class" == 0x03* ]] || continue
        [[ "$vendor" == "0x1002" || "$vendor" == "0x10de" || "$vendor" == "0x8086" ]] || continue
        printf '%s\n' "$dev"
        return 0
    done
    return 1
}

if [[ "${1:-}" == "--available" ]]; then
    find_gpu >/dev/null
    exit $?
fi

dev=$(find_gpu || true)
if [[ -z "$dev" ]]; then
    printf '{"text":"","tooltip":"No GPU found","class":"unavailable"}\n'
    exit 0
fi

vendor=$(<"$dev/vendor")
case "$vendor" in
    0x1002) vendor_name="AMD" ;;
    0x10de) vendor_name="NVIDIA" ;;
    0x8086) vendor_name="Intel" ;;
    *) vendor_name="GPU" ;;
esac

name="$vendor_name GPU"
if command -v lspci >/dev/null 2>&1; then
    pci_id=$(basename "$(readlink -f "$dev")")
    pci_name=$(lspci -s "$pci_id" 2>/dev/null | sed 's/.*: //; s/ (rev .*//')
    [[ -n "$pci_name" ]] && name="$pci_name"
fi

usage=""
temp=""
vram_percent=""
vram_text=""

if [[ -r "$dev/gpu_busy_percent" ]]; then
    usage=$(<"$dev/gpu_busy_percent")
elif command -v nvidia-smi >/dev/null 2>&1; then
    usage=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | sed -n '1p')
fi

if command -v nvidia-smi >/dev/null 2>&1 && [[ "$vendor" == "0x10de" ]]; then
    temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | sed -n '1p')
fi

if [[ -z "$temp" ]]; then
    for input in "$dev"/hwmon/hwmon*/temp*_input; do
        [[ -r "$input" ]] || continue
        raw=$(<"$input")
        [[ "$raw" =~ ^[0-9]+$ ]] || continue
        temp=$(((raw + 500) / 1000))
        break
    done
fi

if [[ -r "$dev/mem_info_vram_used" && -r "$dev/mem_info_vram_total" ]]; then
    vram_used=$(<"$dev/mem_info_vram_used")
    vram_total=$(<"$dev/mem_info_vram_total")
    if (( vram_total > 0 )); then
        vram_percent=$((vram_used * 100 / vram_total))
        vram_text="$((vram_used / 1024 / 1024)) / $((vram_total / 1024 / 1024)) MiB"
    fi
fi

class="normal"
if [[ "$usage" =~ ^[0-9]+$ ]]; then
    (( usage >= 90 )) && class="critical"
    (( usage >= 75 && usage < 90 )) && class="warning"
fi
if [[ "$temp" =~ ^[0-9]+$ ]]; then
    (( temp >= 90 )) && class="critical"
    (( temp >= 80 && temp < 90 && class != "critical" )) && class="warning"
fi
if [[ "$vram_percent" =~ ^[0-9]+$ ]]; then
    (( vram_percent >= 90 )) && class="critical"
    (( vram_percent >= 80 && vram_percent < 90 && class != "critical" )) && class="warning"
fi

text="󰢮"
[[ "$usage" =~ ^[0-9]+$ ]] && text+=" ${usage}%"
[[ "$temp" =~ ^[0-9]+$ ]] && text+=" ${temp}°C"

tooltip="${name}"
[[ "$usage" =~ ^[0-9]+$ ]] && tooltip+="\nUsage: ${usage}%"
[[ "$temp" =~ ^[0-9]+$ ]] && tooltip+="\nTemperature: ${temp}°C"
[[ -n "$vram_text" ]] && tooltip+="\nVRAM: ${vram_text} (${vram_percent}%)"

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
    "$(json_escape "$text")" \
    "$(json_escape "$tooltip")" \
    "$class"
