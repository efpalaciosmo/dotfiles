#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
# shellcheck source=common
. "$script_dir/common"

confirm() {
    local prompt=$1 confirm_label=$2 choice
    choice=$(menu "$prompt" "Cancel" "$confirm_label" || true)
    [[ "$choice" == "$confirm_label" ]]
}

run_systemctl() {
    local action=$1

    if systemctl "$action"; then
        return 0
    fi

    notify_user "Power menu" "Could not run: systemctl $action"
    return 1
}

turn_displays_off() {
    if command -v niri >/dev/null 2>&1 && niri msg action power-off-monitors; then
        return 0
    fi

    notify_user "Power menu" "Could not put displays to sleep"
    return 1
}

lock_session() {
    local lock_script="${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/lock-screen"
    if [[ -x $lock_script ]]; then
        if "$lock_script"; then
            return 0
        fi
        notify_user "Power menu" "Could not lock the session"
    else
        notify_user "Power menu" "Niri screen locker is missing; run make dotfiles"
    fi
    return 1
}

logout_session() {
    if command -v niri >/dev/null 2>&1; then
        niri msg action quit
    elif [[ -n "${XDG_SESSION_ID:-}" ]] && command -v loginctl >/dev/null 2>&1; then
        loginctl terminate-session "$XDG_SESSION_ID"
    fi
}

choice=$(menu "Power" \
    "Lock" \
    "Suspend" \
    "Turn off displays" \
    "Log out" \
    "Restart" \
    "Shut down" || true)

case "$choice" in
    "Shut down")
        confirm "Shut down the computer?" "Shut down" && run_systemctl poweroff
        ;;
    "Restart")
        confirm "Restart the computer?" "Restart" && run_systemctl reboot
        ;;
    "Suspend")
        confirm "Suspend the computer?" "Suspend" && lock_session && run_systemctl suspend
        ;;
    "Lock")
        lock_session
        ;;
    "Log out")
        confirm "Log out?" "Log out" && logout_session
        ;;
    "Turn off displays")
        turn_displays_off
        ;;
esac
