#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
mode=${1:-drun}
# shellcheck source=common
. "$script_dir/common"

if [[ "$mode" == actions ]]; then
    # Each entry shows its direct shortcut so the hub teaches the faster path.
    entry() { if [[ -n ${2:-} ]]; then printf '%-16s  %s\n' "$1" "$2"; else printf '%s\n' "$1"; fi; }
    choice=$(menu "Actions" \
        "$(entry "Applications" "Super+D")" \
        "$(entry "Windows" "Super+Shift+W")" \
        "$(entry "Search files" "Super+/")" \
        "$(entry "Browse files")" \
        "$(entry "Commands" "Super+X")" \
        "$(entry "Clipboard" "Super+Shift+Y")" \
        "$(entry "Screenshots" "Super+Shift+S")" \
        "$(entry "Wi-Fi" "Super+Shift+N")" \
        "$(entry "Connections")" \
        "$(entry "Bluetooth" "Super+Shift+B")" \
        "$(entry "System monitor" "Super+Shift+M")" \
        "$(entry "Disk usage")" \
        "$(entry "Power" "Super+Shift+P")" || true)
    # Labels never contain two consecutive spaces; drop the shortcut column.
    choice=${choice%%  *}
    case "$choice" in
        "Applications") mode=drun ;;
        "Windows") mode=window ;;
        "Search files") mode=recursivebrowser ;;
        "Browse files") mode=filebrowser ;;
        "Commands") mode=run ;;
        "Clipboard") exec "$script_dir/clipboard" ;;
        "Screenshots") exec "$script_dir/screenshot" ;;
        "Wi-Fi") exec "$script_dir/wifi" ;;
        "Connections") missing_commands nm-connection-editor || exit 1; exec nm-connection-editor ;;
        "Bluetooth") exec "$script_dir/bluetooth" ;;
        "System monitor") exec "${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/terminal-tool" monitor ;;
        "Disk usage") exec "${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/terminal-tool" disk ;;
        "Power") exec "$script_dir/power-menu" ;;
        *) exit 0 ;;
    esac
fi

case "$mode" in
    drun)
        missing_commands fuzzel || exit 1
        # Native desktop entries, icons and launch history.
        exec fuzzel
        ;;
    window|recursivebrowser|filebrowser)
        missing_commands fuzzel python3 || exit 1
        exec "$script_dir/picker" "$mode"
        ;;
    run)
        missing_commands fuzzel || exit 1
        exec fuzzel --list-executables-in-path --prompt='Commands  │  '
        ;;
    *) exec "$0" drun ;;
esac
