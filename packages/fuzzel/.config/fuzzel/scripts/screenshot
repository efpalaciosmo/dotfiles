#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
# shellcheck source=common
. "$script_dir/common"

missing_commands niri || exit 1

choice=$(menu "Capturas" \
    "Seleccionar área" \
    "Pantalla actual" \
    "Ventana actual" || true)

case "$choice" in
    "Seleccionar área") niri msg action screenshot ;;
    "Pantalla actual") niri msg action screenshot-screen ;;
    "Ventana actual") niri msg action screenshot-window ;;
esac
