#!/usr/bin/env python3
"""Small bounded Wayland clipboard history (text and PNG, no external daemon)."""

import os
import sqlite3
import sys
from pathlib import Path


def database_path():
    # Keep potentially sensitive clipboard content in the session's private tmpfs.
    # Never silently fall back to persistent storage when no graphical session exists.
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        sys.exit("XDG_RUNTIME_DIR is required for clipboard history")
    root = Path(runtime)
    folder = root / "dotfiles" / "clipboard"
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    return folder / "history.sqlite3"


def main():
    os.umask(0o077)
    if len(sys.argv) < 2 or sys.argv[1] not in {"store", "list", "get", "mime", "clear"}:
        sys.exit("usage: clipboard-history {store TYPE|list|get ID|mime ID|clear}")

    action = sys.argv[1]
    if action == "store" and (len(sys.argv) != 3 or sys.argv[2] not in {"text", "image/png"}):
        sys.exit("store requires text or image/png")

    path = database_path()
    if path.exists():
        path.chmod(0o600)
    with sqlite3.connect(path, timeout=5) as db:
        db.execute("PRAGMA secure_delete=ON")
        db.execute("CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY, mime TEXT NOT NULL, data BLOB NOT NULL)")
        if action == "store":
            mime = "text/plain;charset=utf-8" if sys.argv[2] == "text" else "image/png"
            data = sys.stdin.buffer.read(4 * 1024 * 1024 + 1)
            if not data or len(data) > 4 * 1024 * 1024:
                return
            if mime.startswith("text/") and not data.strip():
                return
            # Restoring an item from the menu should move it to the front,
            # rather than create another copy of the same entry.
            db.execute("DELETE FROM items WHERE mime = ? AND data = ?", (mime, data))
            db.execute("INSERT INTO items(mime, data) VALUES (?, ?)", (mime, data))
            db.execute("DELETE FROM items WHERE id NOT IN (SELECT id FROM items ORDER BY id DESC LIMIT 60)")
        elif action == "list":
            for ident, mime, data in db.execute("SELECT id, mime, data FROM items ORDER BY id DESC"):
                if mime == "image/png":
                    preview = f"Imagen PNG ({(len(data) + 1023) // 1024} KiB)"
                else:
                    preview = data.decode("utf-8", "replace").replace("\n", " ").replace("\t", " ")
                    preview = "".join(ch if ch.isprintable() else " " for ch in preview)
                    preview = preview[:110]
                print(f"{ident}  {preview}")
        elif action == "clear":
            db.execute("DELETE FROM items")
        else:
            if len(sys.argv) != 3 or not sys.argv[2].isdigit():
                sys.exit("entry id required")
            item = db.execute("SELECT mime, data FROM items WHERE id = ?", (int(sys.argv[2]),)).fetchone()
            if item is None:
                sys.exit("entry not found")
            if action == "mime":
                print(item[0])
            else:
                sys.stdout.buffer.write(item[1])


if __name__ == "__main__":
    main()
