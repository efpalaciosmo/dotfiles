#!/usr/bin/env python3
"""Pick and connect to a Wi-Fi network with fuzzel and NetworkManager."""
import subprocess
import sys
import shutil


def command(*args):
    return subprocess.run(
        args, text=True, capture_output=True, check=False
    )


def nmcli(*args):
    return command("nmcli", *args)


def notify(message):
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "Wi-Fi", message],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def error(message):
    notify(message)
    print(f"Wi-Fi: {message}", file=sys.stderr)


def fields(line):
    """Split nmcli's terse output, which escapes colons and backslashes."""
    parts = []
    current = []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            parts.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    parts.append("".join(current))
    return parts


def choose(prompt, choices, message=None):
    args = ["fuzzel", "--dmenu", "--index", "--only-match", "--no-sort",
            "--minimal-lines", "--cache=/dev/null", f"--prompt={prompt}  │  "]
    if message:
        args.append(f"--mesg={message}")
    result = subprocess.run(
        args,
        input="\n".join(choices) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    try:
        index = int(result.stdout.strip())
    except ValueError:
        return None
    return index if 0 <= index < len(choices) else None


def password_for(ssid):
    result = subprocess.run(
        ["fuzzel", "--prompt-only=Clave  │  ", f"--mesg={ssid}", "--password"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout.rstrip("\n")


def wifi_device():
    result = nmcli("-t", "-f", "DEVICE,TYPE", "device", "status")
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        columns = fields(line)
        if len(columns) >= 2 and columns[1] == "wifi":
            return columns[0]
    return None


def networks(device, rescan=False):
    args = ["-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi",
            "list", "ifname", device]
    if rescan:
        args += ["--rescan", "yes"]
    result = nmcli(*args)
    if result.returncode != 0:
        error(result.stderr.strip() or "No se pudieron buscar redes.")
        return None

    strongest = {}
    for line in result.stdout.splitlines():
        columns = fields(line)
        if len(columns) < 4 or not columns[1]:
            continue
        active, ssid, signal, security = columns[:4]
        try:
            strength = int(signal)
        except ValueError:
            strength = 0
        network = (ssid, strength, security, active == "*")
        previous = strongest.get(ssid)
        if previous is None or network[3] or strength > previous[1]:
            strongest[ssid] = network
    return sorted(strongest.values(), key=lambda n: (not n[3], -n[1], n[0].lower()))


def connect(device, ssid, security):
    result = nmcli("--wait", "25", "device", "wifi", "connect", ssid,
                   "ifname", device)
    if result.returncode != 0 and security not in ("", "--"):
        password = password_for(ssid)
        if password is None:
            return
        if not password:
            error("La contraseña está vacía.")
            return
        result = nmcli("--wait", "25", "device", "wifi", "connect", ssid,
                       "password", password, "ifname", device)
    if result.returncode == 0:
        notify(f"Conectado a {ssid}")
    else:
        error(result.stderr.strip() or f"No se pudo conectar a {ssid}.")


def main():
    if not shutil.which("fuzzel") or not shutil.which("nmcli"):
        error("Se necesitan fuzzel y nmcli.")
        return 1
    device = wifi_device()
    if not device:
        error("No se encontró un adaptador Wi-Fi.")
        return 1

    radio = nmcli("radio", "wifi")
    if radio.returncode != 0:
        error("No se pudo consultar el estado del Wi-Fi.")
        return 1
    if radio.stdout.strip() != "enabled":
        if choose("Wi-Fi apagado", ["Activar Wi-Fi"]) == 0:
            result = nmcli("radio", "wifi", "on")
            if result.returncode:
                error(result.stderr.strip() or "No se pudo activar el Wi-Fi.")
                return 1
            notify("Wi-Fi activado")
        return 0

    rescan = False
    while True:
        found = networks(device, rescan=rescan)
        if found is None:
            return 1
        rescan = False
        options = ["Actualizar redes", "Apagar Wi-Fi"]
        for ssid, signal, security, active in found:
            marker = "●" if active else "○"
            lock = " · protegida" if security not in ("", "--") else ""
            options.append(f"{marker}  {ssid}  ·  {signal}%{lock}")
        choice = choose("Wi-Fi", options)
        if choice is None:
            return 0
        if choice == 0:
            rescan = True
            continue
        if choice == 1:
            result = nmcli("radio", "wifi", "off")
            if result.returncode:
                error(result.stderr.strip() or "No se pudo apagar el Wi-Fi.")
                return 1
            notify("Wi-Fi apagado")
            return 0

        ssid, _, security, active = found[choice - 2]
        if active:
            if choose("Wi-Fi", ["Desconectar", "Cancelar"], message=ssid) == 0:
                result = nmcli("device", "disconnect", device)
                if result.returncode:
                    error(result.stderr.strip() or "No se pudo desconectar.")
                    return 1
                notify(f"Desconectado de {ssid}")
            return 0
        connect(device, ssid, security)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
