#!/usr/bin/env bash
set -euo pipefail

script_dir=${BASH_SOURCE[0]%/*}
# shellcheck source=common
. "$script_dir/common"

missing_commands fuzzel bluetoothctl rfkill systemctl || exit 1

bluetooth_error() {
    notify_user "Bluetooth" "$1"
    printf 'Bluetooth: %s\n' "$1" >&2
    exit 1
}

systemctl is-active --quiet bluetooth.service ||
    bluetooth_error "The Bluetooth service is inactive. Check systemctl status bluetooth.service and your distribution configuration."

controller=$(bluetoothctl --timeout 5 show 2>/dev/null || true)
[[ $controller == Controller\ * ]] || bluetooth_error "No Bluetooth adapter found."

power_on() {
    if rfkill -n -o HARD list bluetooth | grep -qx blocked; then
        bluetooth_error "Bluetooth is blocked by hardware. Check the physical switch or airplane mode."
    fi
    if rfkill -n -o SOFT list bluetooth | grep -qx blocked; then
        if ! rfkill unblock bluetooth >/dev/null 2>&1; then
            if ! command -v pkexec >/dev/null 2>&1 || ! pkexec rfkill unblock bluetooth; then
                bluetooth_error "Could not unblock Bluetooth. Try: sudo rfkill unblock bluetooth"
            fi
        fi
    fi
    bluetoothctl power on >/dev/null 2>&1 || bluetooth_error "Could not turn on the Bluetooth adapter."
}

run_device_action() {
    local action=$1 mac=$2 label=$3
    if ! bluetoothctl --timeout 30 "$action" "$mac" >/dev/null 2>&1; then
        bluetooth_error "Could not $label. Check that the device is turned on and nearby."
    fi
}

while :; do
    controller=$(bluetoothctl --timeout 5 show 2>/dev/null || true)
    [[ $controller == Controller\ * ]] || bluetooth_error "No Bluetooth adapter found."
    if [[ $controller != *'Powered: yes'* ]]; then
        choice=$(menu "Bluetooth" "Turn on Bluetooth" || true)
        [[ $choice == "Turn on Bluetooth" ]] || exit 0
        power_on
        continue
    fi

    options=("Scan for devices (10 s)" "Turn off Bluetooth")
    macs=() labels=()
    while IFS= read -r line; do
        if [[ $line =~ ^Device[[:space:]]+(([[:xdigit:]]{2}:){5}[[:xdigit:]]{2})[[:space:]]+(.+)$ ]]; then
            mac=${BASH_REMATCH[1]}
            name=${BASH_REMATCH[3]}
            info=$(bluetoothctl info "$mac" 2>/dev/null || true)
            if [[ $info == *'Connected: yes'* ]]; then
                state="connected"
            elif [[ $info == *'Paired: yes'* ]]; then
                state="paired"
            else
                state="new"
            fi
            labels+=("$name · $state · $mac")
            macs+=("$mac")
            options+=("${labels[-1]}")
        fi
    done < <(bluetoothctl devices 2>/dev/null)

    choice=$(menu "Bluetooth" "${options[@]}" || true)
    case "$choice" in
        "Scan for devices (10 s)")
            bluetoothctl --timeout 10 scan on >/dev/null 2>&1 || true
            bluetoothctl scan off >/dev/null 2>&1 || true
            continue
            ;;
        "Turn off Bluetooth")
            bluetoothctl power off >/dev/null 2>&1 || bluetooth_error "Could not turn off Bluetooth."
            exit 0
            ;;
        "") exit 0 ;;
    esac

    selected=""
    for i in "${!labels[@]}"; do
        if [[ $choice == "${labels[$i]}" ]]; then
            selected=${macs[$i]}
            break
        fi
    done
    [[ -n $selected ]] || exit 0

    info=$(bluetoothctl info "$selected" 2>/dev/null || true)
    if [[ $info == *'Connected: yes'* ]]; then
        action=$(menu "Connected" "Disconnect" "Forget device" || true)
    elif [[ $info == *'Paired: yes'* ]]; then
        action=$(menu "Paired" "Connect" "Forget device" || true)
    else
        action=$(menu "New" "Pair and connect" || true)
    fi

    case "$action" in
        "Pair and connect")
            run_device_action pair "$selected" "pair the device"
            bluetoothctl trust "$selected" >/dev/null 2>&1 || true
            run_device_action connect "$selected" "connect the device"
            notify_user "Bluetooth" "Device connected."
            ;;
        "Connect")
            run_device_action connect "$selected" "connect the device"
            notify_user "Bluetooth" "Device connected."
            ;;
        "Disconnect")
            run_device_action disconnect "$selected" "disconnect the device"
            notify_user "Bluetooth" "Device disconnected."
            ;;
        "Forget device")
            confirm=$(menu "Forget device?" "Cancel" "Forget" || true)
            [[ $confirm == Forget ]] || exit 0
            run_device_action remove "$selected" "forget the device"
            notify_user "Bluetooth" "Device forgotten."
            ;;
    esac
    exit 0
done
